# The production environment file.
#
# Copy this to `.env` on the server, fill in the blanks, and run
# `php artisan key:generate`. DEPLOYMENT.md walks through the rest.
#
# Everything here differs from `.env.example` on purpose: that file is for a
# machine somebody is working on, this one is for a site taking bookings.

APP_NAME="Lakeside Hotel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# The address guests type, including the scheme. Signed booking links and the
# sitemap are built from this, so an http:// here is a broken confirmation email.
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# `debug` on a live site fills the log with noise and, if a page ever errors,
# prints the stack trace to the guest. `warning` keeps what is worth acting on.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lakeside_hotel
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Only set once the site is served over HTTPS. On plain HTTP the browser drops
# the session cookie and nobody can sign in.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Where the hotel's own mail goes out from. Booking confirmations and the
# contact form replies leave through this, so it has to be a real mailbox the
# sending server is allowed to use - `log` means guests never hear from you.
MAIL_MAILER=smtp
# `null` with port 587 negotiates STARTTLS; use `smtps` with port 465 when the
# provider expects implicit TLS.
MAIL_SCHEME=null
MAIL_HOST=smtp.your-provider.example
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="reservations@lakesidehotelmw.net"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Media: every upload and every generated size lands in public/bucket, which the
# web server serves directly. Leave MEDIA_DISK as `bucket` unless you are moving
# the library to S3, in which case MEDIA_URL has to change with it.
MEDIA_DISK=bucket
MEDIA_URL=/bucket
QUEUE_CONVERSIONS_BY_DEFAULT=false

VITE_APP_NAME="${APP_NAME}"

HOTEL_COUNTRY=MW

# PayChangu - card and mobile money payments.
#
# A test key addresses the sandbox, a live key takes real money; there is no
# other switch. Leave the secret key blank to keep taking reservations that are
# settled at the hotel: the site fails safe and simply does not offer Pay Now.
# The webhook secret proves that a call to /webhooks/paychangu came from
# PayChangu, so it has to be set before any online payment can be trusted.
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_BASE_URL=https://api.paychangu.com
PAYCHANGU_TIMEOUT=20
